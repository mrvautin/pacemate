<resources xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">

    <!--
        Shared property definitions for PaceMateField and PaceMateWidget.
        Both apps declare the SAME property ids/types here so their
        values interoperate: Garmin Connect Mobile, Garmin Express, and
        each app's own on-device settings all read/write the same keys.
        Canonical units: distance in meters, time in seconds.
    -->
    <properties>
        <property id="raceDistanceM" type="float">5000.0</property>
        <property id="finishTimeSec" type="number">1800</property>
        <property id="distanceUnits" type="number">0</property>

        <!--
            Phone-facing mirrors of the canonical properties above, shown
            in Garmin Connect Mobile/Express (which can only show plain
            numeric fields, not the on-watch H/M/S or unit-aware pickers).
            raceDistanceDisplay is in whichever unit distanceUnits selects
            (km or miles); finishTimeMin is in minutes. AppBase.onSettingsChanged()
            converts these into the canonical meters/seconds properties.
        -->
        <property id="raceDistanceDisplay" type="float">5.0</property>
        <property id="finishTimeMin" type="number">30</property>

        <!--
            Field visibility toggles (Garmin Connect Mobile/Express only -
            not exposed on-device, since the watch's own settings menu is
            for race parameters, not layout). Hiding a field lets the
            remaining fields grow to fill the space; Current Pace always
            shows since it's the field's whole reason to exist.
        -->
        <property id="showTargetPace" type="boolean">false</property>
        <property id="showDelta" type="boolean">true</property>
        <property id="showProjectedFinish" type="boolean">true</property>
        <property id="showAveragePace" type="boolean">true</property>
        <property id="showSplitPace" type="boolean">false</property>
        <property id="showFinishDelta" type="boolean">false</property>

        <!--
            Current-pace smoothing window, in meters. Phone-configured
            only - it's a display-smoothing preference, not a race
            parameter, so it doesn't belong on the watch's own race-setup
            menu (Race Distance / Finish Time / Units).
        -->
        <property id="paceSmoothingM" type="number">100</property>

        <!--
            Forces the field's background to black or white, regardless
            of the watch's own field/theme background. Phone-configured
            only. Defaults to black (0).
        -->
        <property id="backgroundMode" type="number">0</property>
    </properties>

</resources>
